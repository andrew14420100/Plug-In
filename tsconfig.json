{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"lib": [ "DOM", "DOM.Iterable", "ES2020" ],
		"types": [ "jest" ]
	},
	"include": [ "frontend/src/**/*", "frontend/tests/**/*" ]
}
