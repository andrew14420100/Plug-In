{
    "name": "bracelli/bracelli-club",
    "description": "Bracelli Club Plug-In — strumenti di sviluppo e test (il plugin non ha dipendenze Composer di runtime).",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Bracelli\\Club\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test:unit": "phpunit -c phpunit-unit.xml.dist",
        "test:integration": "phpunit -c phpunit-integration.xml.dist"
    }
}
