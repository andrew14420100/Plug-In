<?xml version="1.0"?>
<ruleset name="Bracelli Club">
	<description>WordPress Coding Standards (Extra) + compatibilità PHP per il plugin Bracelli Club.</description>

	<file>plugin/bracelli-club</file>
	<exclude-pattern>plugin/bracelli-club/assets/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="6.9"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra">
		<!-- Classi PSR-4 (src/Nome/Classe.php) invece di class-nome.php. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Sintassi array breve consentita (PHP moderno, nessun impatto funzionale). -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="bracelli-club"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="bracelli_club"/>
				<element value="Bracelli\Club"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
